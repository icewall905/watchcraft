# Optional whole-app passphrase (empty = off; profile PINs are separate).
BT_PASSWORD=
# Cookie signing secret is generated in the data directory if empty.
BT_SECRET=
# AI settings can be configured in Settings > AI after startup.
BT_LLM_BASE_URL=
BT_LLM_MODEL=
BT_LLM_API_KEY=
BT_POT_URL=http://pot:4416
BT_YTDLP_AUTOUPDATE=1
BT_PORT=6645
BT_DATA_HOST_DIR=./data
BT_MEDIA_HOST_DIR=./media
# Optional voice search and generated subtitles (OpenAI-compatible speech-to-text).
# Initial defaults; editable under Settings > Player > Generated subtitles.
# compose.watchcraft.yaml defaults to the household Qwen ASR proxy on port 8011.
WC_STT_BASE_URL=
WC_STT_MODEL=Qwen/Qwen3-ASR-1.7B
WC_STT_API_KEY=
# Empty = let the STT service detect the language.
WC_STT_LANGUAGE=

# Optional Music Assistant playlist import (server-side only).
# Use a direct Music Assistant server address, e.g. http://192.168.1.10:8095.
# Create a long-lived access token in Music Assistant Settings > Profile.
MUSIC_ASSISTANT_URL=
MUSIC_ASSISTANT_TOKEN=
